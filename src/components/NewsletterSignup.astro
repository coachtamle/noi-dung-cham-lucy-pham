<section class="newsletter-signup" aria-labelledby="newsletter-title">
	<p class="newsletter-label">Thành viên Góc chuyên môn</p>
	<h2 id="newsletter-title">Đăng ký thành viên để đọc bài viết mới nhất</h2>
	<p class="newsletter-description">
		Nhận thông báo qua email mỗi khi Lucy có bài viết mới.
	</p>

	<form class="newsletter-form" data-newsletter-form>
		<label class="sr-only" for="newsletter-email">Địa chỉ email</label>
		<input
			id="newsletter-email"
			class="newsletter-input"
			name="email"
			type="email"
			inputmode="email"
			autocomplete="email"
			placeholder="Email của bạn"
			maxlength="254"
			required
		/>
		<input class="newsletter-honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
		<button class="newsletter-button" type="submit">Đăng ký</button>
		<p class="newsletter-consent">
			Bằng việc đăng ký, bạn đồng ý nhận email thông báo bài viết mới và có thể hủy đăng ký bất cứ lúc nào.
		</p>
		<p class="newsletter-status" data-newsletter-status role="status" aria-live="polite"></p>
	</form>
</section>

<script>
	const forms = document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]");

	for (const form of forms) {
		if (form.dataset.ready === "true") continue;
		form.dataset.ready = "true";

		const status = form.querySelector<HTMLElement>("[data-newsletter-status]");
		const button = form.querySelector<HTMLButtonElement>("button[type='submit']");

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!status || !button) return;

			status.textContent = "";
			status.className = "newsletter-status";
			button.disabled = true;
			button.textContent = "Đang đăng ký...";

			try {
				const response = await fetch("/api/newsletter/subscribe", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						...Object.fromEntries(new FormData(form)),
						source: window.location.pathname,
					}),
				});
				const result = await response.json() as { message?: string };

				if (!response.ok) throw new Error(result.message || "Không thể đăng ký lúc này.");

				form.reset();
				status.textContent = result.message || "Đăng ký thành công. Cảm ơn bạn!";
				status.classList.add("is-success");
			} catch (error) {
				status.textContent = error instanceof Error ? error.message : "Không thể đăng ký lúc này.";
				status.classList.add("is-error");
			} finally {
				button.disabled = false;
				button.textContent = "Đăng ký";
			}
		});
	}
</script>

<style>
	.newsletter-signup {
		padding: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
		border-radius: var(--radius-lg);
		background: color-mix(in srgb, var(--color-accent) 4%, var(--color-bg));
	}

	.newsletter-label {
		margin: 0 0 0.65rem;
		color: var(--color-accent);
		font-size: var(--font-size-xs);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.newsletter-signup h2 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 1.12rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0;
		color: var(--color-text);
	}

	.newsletter-description {
		margin: 0.65rem 0 0;
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		line-height: 1.55;
	}

	.newsletter-form {
		display: grid;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.newsletter-input {
		width: 100%;
		min-height: 42px;
		padding: 0.7rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
		outline: none;
		transition: border-color 150ms ease, box-shadow 150ms ease;
	}

	.newsletter-input:focus {
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 14%, transparent);
	}

	.newsletter-button {
		min-height: 42px;
		padding: 0.7rem 1rem;
		border: 1px solid var(--color-accent);
		border-radius: var(--radius);
		background: var(--color-accent);
		color: #fff;
		font: inherit;
		font-size: var(--font-size-sm);
		font-weight: 700;
		cursor: pointer;
		transition: opacity 150ms ease, transform 150ms ease;
	}

	.newsletter-button:hover {
		opacity: 0.9;
	}

	.newsletter-button:active {
		transform: translateY(1px);
	}

	.newsletter-button:disabled {
		cursor: wait;
		opacity: 0.65;
	}

	.newsletter-consent,
	.newsletter-status {
		margin: 0;
		font-size: 0.72rem;
		line-height: 1.45;
	}

	.newsletter-consent {
		color: var(--color-muted);
	}

	.newsletter-status:empty {
		display: none;
	}

	.newsletter-status.is-success {
		color: var(--color-accent);
		font-weight: 700;
	}

	.newsletter-status.is-error {
		color: #a43b32;
	}

	.newsletter-honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
