---
import type { MediaValue, ContentBylineCredit } from "emdash";
import { Image } from "emdash/ui";
import { normalizeContentTitle } from "../utils/content-text";
import { getPostFeaturedImage } from "../utils/post-image";

interface Props {
  title: string;
  excerpt?: string;
  featuredImage?: MediaValue | string;
  href: string;
  date?: Date;
  readingTime?: number;
  tags?: Array<{ slug: string; label: string }>;
  bylines?: ContentBylineCredit[];
}

const { title, excerpt, featuredImage, href, readingTime, tags, bylines } = Astro.props;
const displayTitle = normalizeContentTitle(title);
const postSlug = href.split("/").filter(Boolean).pop();
const resolvedFeaturedImage = getPostFeaturedImage(postSlug, featuredImage);
const featuredImageUrl = typeof resolvedFeaturedImage === "string" ? resolvedFeaturedImage : null;
const featuredImageMedia = featuredImageUrl ? null : resolvedFeaturedImage as MediaValue | undefined;
const primaryTag = tags?.[0]?.label ?? "Blog";
const author = bylines?.[0]?.byline.displayName ?? "Lucy Pham";
---

<article class="post-card">
  <!-- Row 1: image -->
  <a href={href} class="card-image-link" tabindex="-1">
    {featuredImageUrl ? (
      <div class="card-image">
        <img src={featuredImageUrl} alt={displayTitle} loading="lazy" />
      </div>
    ) : featuredImageMedia ? (
      <div class="card-image">
        <Image image={featuredImageMedia} />
      </div>
    ) : (
      <div class="card-image card-image--empty">
        <span>{primaryTag}</span>
      </div>
    )}
  </a>

  <!-- Row 2: meta -->
  <div class="card-meta">
    <span>{author}</span>
    {tags && tags.length > 0 && (
      <>
        <span class="sep">/</span>
        <a href={`/tag/${tags[0].slug}`}>{tags[0].label}</a>
      </>
    )}
    {(!tags || tags.length === 0) && readingTime && <span>{readingTime} phút đọc</span>}
  </div>

  <!-- Row 3: title -->
  <a href={href} class="card-title-link">
    <h2>{displayTitle}</h2>
  </a>

  <!-- Row 4: excerpt (always present so subgrid rows stay consistent) -->
  <p class="card-excerpt">{excerpt ?? ""}</p>
</article>

<style>
  .post-card {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    align-content: start;
  }

  .card-image-link {
    display: block;
  }

  .card-image {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    aspect-ratio: 16 / 9;
  }


  .card-image img,
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .card-image--empty {
    aspect-ratio: 16 / 9;
  }

  .card-image--empty {
    display: grid;
    place-items: center;
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-transform: uppercase;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding-top: 0.75rem;
  }

  .card-meta a {
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sep { flex-shrink: 0; }

  .card-title-link {
    display: block;
    text-decoration: none;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.55vw, 1.45rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0;
    color: var(--color-text);
    transition: opacity 150ms;
    margin: 0;
    padding-top: 0.45rem;
  }

  .post-card:hover h2 {
    opacity: 0.72;
  }

  .card-excerpt {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: 1.65;
    margin: 0;
    padding-top: 0.45rem;
    padding-bottom: 2.5rem; /* creates space between card groups */
  }
</style>
