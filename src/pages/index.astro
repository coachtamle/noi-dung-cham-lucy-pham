---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import { normalizeContentTitle } from "../utils/content-text";
import { getReadingTime } from "../utils/reading-time";
import { getPostFeaturedImage } from "../utils/post-image";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 24 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const categoriesByEntry = await getTermsForEntries("posts", posts.map((p) => p.data.id), "category");
const categoryLabels: Record<string, string> = {
	"chien-luoc-noi-dung": "Chiến lược nội dung",
	"content-thau-cam": "Content thấu cảm",
	"quan-tri-va-chien-luoc": "Quản trị & Chiến lược",
	"phat-trien-su-nghiep": "Phát triển sự nghiệp",
	"tong-giong-thuong-hieu": "Tông giọng thương hiệu",
};
const postsWithTags = posts.map((post) => ({ post, tags: (categoriesByEntry.get(post.data.id) ?? []).map((cat) => ({ slug: cat.slug, label: categoryLabels[cat.slug] ?? cat.label })) }));
const pillars = [
	{ label: "Chiến lược nội dung", slug: "chien-luoc-noi-dung" },
	{ label: "Content thấu cảm", slug: "content-thau-cam" },
	{ label: "Quản trị & Chiến lược", slug: "quan-tri-va-chien-luoc" },
	{ label: "Phát triển sự nghiệp", slug: "phat-trien-su-nghiep" },
	{ label: "Tông giọng thương hiệu", slug: "tong-giong-thuong-hieu" },
];
const homepageCategoryLimits: Partial<Record<string, number>> = { "chien-luoc-noi-dung": 1, "content-thau-cam": 1, "quan-tri-va-chien-luoc": 1, "phat-trien-su-nghiep": 1, "tong-giong-thuong-hieu": 1 };
const featuredPostsWithTags = pillars.reduce<((typeof postsWithTags)[number] & { homeCategory: (typeof pillars)[number] })[]>((selected, pillar) => {
	const limit = homepageCategoryLimits[pillar.slug] ?? 0;
	if (limit <= 0) return selected;
	const postsInCategory = postsWithTags.filter(({ post, tags }) => tags.some((tag) => tag.slug === pillar.slug) && !selected.some((item) => item.post.id === post.id));
	selected.push(...postsInCategory.slice(0, limit).map((item) => ({ ...item, homeCategory: pillar })));
	return selected;
}, []);
const projectLogos = [
	{ name: "Horizon Group", src: "/media/project-logos/skyscanner.svg" },
	{ name: "Artisan Living", src: "/media/project-logos/psa.svg" },
	{ name: "Novawear", src: "/media/project-logos/xe-auto.svg" },
	{ name: "GreenScape Tech", src: "/media/images/project-logos/skyscanner.svg" },
];
const projectLogoLoop = [...projectLogos, ...projectLogos, ...projectLogos, ...projectLogos];
---

<Base title="Nội Dung Chạm - Lucy Phạm" description="Lucy Phạm - Strategic Content Architect & Brand Storyteller, đồng hành cùng thương hiệu khai quật giá trị cốt lõi và biến thông điệp thành câu chuyện giàu sức chạm." image="/media/images/lucy/6852.jpg">
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Lucy Phạm | Strategic Content Architect</p>
			<h1><span class="hero-line-nowrap">Sáng tạo câu chuyện</span><span class="hero-line-nowrap">Định hình vị thế thương hiệu</span></h1>
			<p class="hero-sub">Nội dung không đơn thuần là những con chữ ghép lại với nhau. Nội dung là chiếc cầu nối cảm xúc giữa tầm nhìn doanh nghiệp và trái tim khách hàng. Mình đồng hành cùng các thương hiệu trong việc khai quật giá trị cốt lõi, biến những thông điệp khô khan thành câu chuyện giàu sức chạm, giúp thương hiệu không chỉ tạo ấn tượng mạnh mẽ mà còn xây dựng niềm tin bền vững.</p>
			<div class="actions"><a class="btn-primary" href="/#dich-vu">Khám phá giải pháp</a><a class="btn-secondary" href="/posts">Góc chuyên môn</a></div>
		</div>
		<div class="hero-media" aria-label="Lucy Phạm - Strategic Content Architect"><div class="hero-portrait"><img src="/media/images/lucy/6852.jpg" alt="Lucy Phạm - Strategic Content Architect" loading="eager" /></div><div class="hero-note"><strong>8 năm</strong><span>đồng hành cùng nội dung tạo chuyển đổi</span></div></div>
	</section>
	<section class="credentials"><div class="credentials-inner"><article><strong>8+</strong><span>năm chinh chiến thực chiến<br />trong Content & Brand Marketing</span></article><article><strong>35+</strong><span>thương hiệu & tập đoàn<br />đa lĩnh vực đã được tư vấn</span></article><article><strong>2.500+</strong><span>ấn phẩm truyền thông,<br />bài viết chuyên sâu & kịch bản</span></article></div></section>
	<section class="philosophy"><div class="philosophy-inner"><blockquote><span class="quote-icon" aria-hidden="true">“</span><div><p>Giá trị chân thật tạo nên kết nối sâu sắc. Khi thương hiệu cất lời bằng sự tử tế và thấu cảm, khách hàng sẽ tự tìm đến.</p><cite>Lucy Phạm</cite></div></blockquote></div></section>
	<section class="project-logos" aria-labelledby="project-logos-title"><div class="project-logos-inner"><div class="project-logos-header"><p class="eyebrow">Thương hiệu đã từng tư vấn & đồng hành</p></div><div class="logo-marquee" aria-label="Thương hiệu đã từng tư vấn và đồng hành"><div class="logo-marquee-track">{projectLogoLoop.map((logo) => (<div class="project-logo-card">{logo.src ? <img src={logo.src} alt={logo.name} loading="lazy" /> : <span>{logo.name}</span>}</div>))}</div></div></div></section>
	<section class="about"><div class="about-media"><img src="/media/images/lucy/2148854508.jpg" alt="Lucy Phạm đang làm việc" loading="lazy" /></div><div class="about-copy"><p class="eyebrow">Đôi điều về Lucy</p><h2>8 năm làm nghề - Hành trình tìm kiếm những điểm chạm nguyên bản.</h2><p>Bắt đầu dấn thân vào lĩnh vực Truyền thông - Content Marketing từ năm 2018, mình tích lũy trải nghiệm từ các mô hình Agency tổng thể trước khi bước ra hoạt động độc lập vào năm 2019.</p><p>Tới năm 2020, dự án "Nội Dung Chạm" được khai sinh nhằm mang đến giải pháp chiến lược nội dung tinh gọn, sâu sắc và giàu tính bản sắc cho các thương hiệu Việt. Điều khiến mình luôn tràn đầy nhiệt huyết sau gần một thập kỷ viết lách là cơ hội được lắng nghe bài toán riêng của từng doanh nghiệp, cùng họ khai phá chiều sâu thương hiệu và biến triết lý kinh doanh thành những thông điệp có sức hút tự nhiên.</p><a class="btn-secondary" href="/ve-toi">Tìm hiểu thêm về Lucy</a></div></section>
	<section id="dich-vu" class="services"><div class="section-header"><div><h2 class="section-title">Dịch vụ chuyên môn</h2><p class="section-subtitle">Giải pháp nội dung toàn diện giúp nâng tầm thương hiệu và thúc đẩy tăng trưởng kinh doanh.</p></div><a href="/#contact" class="rune-section-link">Liên hệ trao đổi</a></div><div class="service-grid">
		<article class="service-card"><div class="service-img"><img src="/media/images/lucy/2148552177.jpg" alt="Định hướng chiến lược nội dung" loading="lazy" /></div><span class="service-num">01</span><div class="service-body"><h3>ĐỊNH HƯỚNG & XÂY DỰNG CHIẾN LƯỢC NỘI DUNG</h3><p class="service-intro">Thiết kế kiến trúc nội dung tổng thể bám sát mục tiêu Brand & Performance Marketing:</p><ul class="service-points"><li>Nghiên cứu chân dung khách hàng sâu và phân tích đối thủ.</li><li>Xác định Brand Voice và thông điệp cốt lõi.</li><li>Lập Content Plan 3 - 6 - 12 tháng.</li><li>Xây dựng Content Calendar và tỉ trọng phân bổ kênh.</li><li>Định hướng visual và nội dung chi tiết cho từng chiến dịch.</li></ul></div><div class="service-footer"><div class="service-tags"><span>Tái cấu trúc thương hiệu</span><span>Ra mắt sản phẩm mới</span></div><a href="/#contact" class="service-link">Liên hệ</a></div></article>
		<article class="service-card"><div class="service-img"><img src="/media/images/lucy/25951.jpg" alt="Cố vấn nội dung định kỳ" loading="lazy" /></div><span class="service-num">02</span><div class="service-body"><h3>TƯ VẤN & CỐ VẤN NỘI DUNG ĐỊNH KỲ</h3><p class="service-intro">Đồng hành cùng ban lãnh đạo hoặc đội ngũ in-house để rà soát, định hướng và nâng cấp chất lượng truyền thông:</p><ul class="service-points"><li>Audit toàn bộ hệ thống kênh nội dung hiện có.</li><li>Chuẩn hóa SOP sản xuất nội dung cho team in-house.</li><li>Đào tạo và mentoring 1:1 cho Content Team.</li><li>Cố vấn định hướng nội dung định kỳ tuần/tháng.</li></ul></div><div class="service-footer"><div class="service-tags"><span>Doanh nghiệp</span><span>Agency</span></div><a href="/#contact" class="service-link">Liên hệ</a></div></article>
		<article class="service-card"><div class="service-img"><img src="/media/images/lucy/28066.jpg" alt="Sản xuất nội dung đa kênh" loading="lazy" /></div><span class="service-num">03</span><div class="service-body"><h3>PRODUCE & SẢN XUẤT NỘI DUNG ĐA KÊNH</h3><p class="service-intro">Trực tiếp sáng tạo các ấn phẩm truyền thông chất lượng cao, đúng định vị thương hiệu:</p><ul class="service-points"><li>Company Profile và Brand Story.</li><li>Bài PR báo chí và thông cáo báo chí.</li><li>Nội dung website, landing page chuẩn UX Writing & SEO.</li><li>Kịch bản video ngắn, TVC và Corporate Video.</li><li>Chăm sóc nội dung Social Media chuyên sâu.</li></ul></div><div class="service-footer"><div class="service-tags"><span>Doanh nghiệp</span><span>Founder</span></div><a href="/#contact" class="service-link">Liên hệ</a></div></article>
		<article class="service-card"><div class="service-img"><img src="/media/images/lucy/6851.jpg" alt="Mentoring content thực chiến" loading="lazy" /></div><span class="service-num">04</span><div class="service-body"><h3>MENTORING & ĐÀO TẠO CONTENT THỰC CHIẾN</h3><p class="service-intro">Chương trình huấn luyện chuyên sâu cho người muốn phát triển sự nghiệp Content Marketing bền vững:</p><ul class="service-points"><li>Khai phóng tư duy Content Strategist.</li><li>Rèn luyện nghiên cứu insights và viết bài có chiều sâu.</li><li>Đóng gói dịch vụ, định giá chuyên môn và freelancing.</li><li>Xây dựng portfolio cá nhân thu hút khách hàng cao cấp.</li></ul></div><div class="service-footer"><div class="service-tags"><span>Junior Writer</span><span>Freelancer</span></div><a href="/#contact" class="service-link">Liên hệ</a></div></article>
	</div></section>
	<section class="blog-preview"><div class="section-header"><div><h2 class="section-title">Góc chuyên môn</h2><p class="section-subtitle">Nơi Lucy chia sẻ trải nghiệm thực chiến, tư duy chiến lược và những góc nhìn về ngành Content Marketing.</p></div><a href="/posts" class="rune-section-link">Xem tất cả</a></div><div class="pillar-list">{pillars.map((p) => (<a href={`/tag/${p.slug}`}>{p.label}</a>))}</div>{featuredPostsWithTags.length === 0 ? <p class="empty">Bài viết đang được chuẩn bị, quay lại sớm nhé.</p> : <div class="home-post-list">{featuredPostsWithTags.map(({ post, homeCategory }) => (<a href={`/posts/${post.id}`} class="home-post-row"><div class="home-post-thumb">{typeof getPostFeaturedImage(post.id, post.data.featured_image, post.data.title) === "string" ? <img src={getPostFeaturedImage(post.id, post.data.featured_image, post.data.title) as string} alt={normalizeContentTitle(post.data.title)} loading="lazy" /> : <div class="home-post-placeholder" />}</div><div class="home-post-content"><span class="home-post-tag">{homeCategory.label}</span><h3 class="home-post-title">{normalizeContentTitle(post.data.title)}</h3>{post.data.excerpt && <p class="home-post-excerpt">{post.data.excerpt}</p>}<div class="home-post-meta">{post.data.publishedAt && <time>{new Date(post.data.publishedAt).toLocaleDateString("vi-VN", { day: "numeric", month: "long", year: "numeric" })}</time>}{getReadingTime(post.data.content) > 0 && <span>{getReadingTime(post.data.content)} phút đọc</span>}</div></div></a>))}</div>}</section>
	<section id="contact" class="contact"><p class="eyebrow">Liên hệ hợp tác</p><h2>Sẵn sàng nâng tầm nội dung cho thương hiệu của bạn?</h2><p>Mỗi thương hiệu đều chứa đựng một câu chuyện độc bản. Hãy để Lucy giúp bạn kể lại câu chuyện ấy bằng ngôn ngữ truyền cảm, chuẩn chiến lược và chạm đến trái tim khách hàng.</p><div class="actions"><a class="btn-primary" href="https://web.facebook.com/lucypham.contentstrategist/" target="_blank" rel="noopener noreferrer">Facebook</a><a class="btn-secondary" href="mailto:lucypham.content@gmail.com">lucypham.content@gmail.com</a><a class="btn-secondary" href="https://zalo.me/0988654321" target="_blank" rel="noopener noreferrer">Zalo: 0988 654 321</a></div></section>
</Base>

<style>

	/* ── Hero ── */
	.hero {
		display: grid;
		gap: 2rem;
		align-items: center;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 2rem 1.25rem 2rem;
		overflow: hidden;
	}

	.hero h1 {
		max-width: 720px;
		font-family: var(--font-serif) !important;
		font-size: clamp(1.2rem, 4.2vw, 1.8rem);
		line-height: 1.18;
		letter-spacing: -0.012em;
		text-transform: none;
	}

	.hero h1 span {
		display: block;
	}

	.hero-line-nowrap {
		white-space: normal;
	}

	.hero-sub {
		max-width: 640px;
		margin-top: 1.5rem;
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
	}

	.eyebrow {
		margin-bottom: 1rem;
		color: var(--color-accent);
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.025em;
		line-height: 1.45;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.hero-media {
		position: relative;
		padding: 1rem;
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		min-width: 0;
	}

	.hero-portrait {
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: calc(var(--radius-lg) - 0.75rem);
	}

	.hero-portrait img,
	.about-media img,
	.service-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.home-post-thumb img {
		width: 100%;
		height: auto;
		display: block;
	}

	.hero-note {
		position: absolute;
		right: 1rem;
		bottom: 2rem;
		display: grid;
		gap: 0.25rem;
		max-width: 220px;
		padding: 1.25rem;
		background: var(--color-accent);
		color: var(--color-bg);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
	}

	.hero-note strong {
		font-family: var(--font-serif);
		font-size: 2rem;
	}

	@media (max-width: 640px) {
		.hero-media {
			min-height: auto;
			padding: 0.75rem;
		}

		.hero-portrait {
			aspect-ratio: 4 / 5;
			height: auto;
			min-height: 0;
		}

		.hero-note {
			position: static;
			grid-template-columns: auto 1fr;
			align-items: center;
			gap: 0.75rem;
			max-width: none;
			margin-top: 0.75rem;
			padding: 0.9rem 1rem;
			border-radius: var(--radius-md);
			box-shadow: none;
		}

		.hero-note strong {
			font-size: 1.75rem;
			line-height: 1;
			white-space: nowrap;
		}

		.hero-note span {
			font-size: 0.95rem;
			line-height: 1.35;
		}
	}

	/* ── Credentials ── */
	.credentials {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 1rem 1.25rem 3rem;
	}

	.credentials-inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		overflow: hidden;
		background: var(--color-border);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.credentials article {
		padding: 1.5rem;
		background: var(--color-bg);
	}

	.credentials strong {
		display: block;
		margin-bottom: 0.35rem;
		font-family: var(--font-serif);
		font-size: clamp(2.4rem, 6vw, 5rem);
		line-height: 1;
		color: var(--color-accent);
	}

	.credentials span {
		color: var(--color-text-secondary);
	}

	/* ── Philosophy ── */
	.philosophy {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 1.25rem 3rem;
	}

	.philosophy-inner {
		padding: 1.75rem;
		background: var(--color-surface);
		border-radius: var(--radius-lg);
	}

	blockquote {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		align-items: start;
		margin: 0;
	}

	.quote-icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-family: var(--font-serif);
		font-size: 3rem;
		line-height: 1;
	}

	blockquote p {
		max-width: 980px;
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 3vw, 2.5rem);
		line-height: 1.2;
	}

	blockquote cite {
		display: block;
		margin-top: 1.5rem;
		color: var(--color-text-secondary);
		font-style: normal;
	}

	/* ── Project logos ── */
	.project-logos {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 1.25rem 3rem;
	}

	.project-logos-inner {
		display: grid;
		gap: 1.25rem;
		padding: 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
	}

	.project-logos-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
	}

	.project-logos-header .eyebrow {
		margin-bottom: 0;
	}

	.project-logos h2 {
		max-width: 480px;
		color: var(--color-text);
		font-family: var(--font-sans) !important;
		font-size: clamp(1rem, 1.5vw, 1.2rem);
		font-weight: 600;
		line-height: 1.45;
		text-align: right;
	}

	.logo-marquee {
		position: relative;
		overflow: hidden;
		padding: 0.2rem 0;
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.logo-marquee-track {
		display: flex;
		width: max-content;
		gap: 0.75rem;
		animation: logo-scroll 86s linear infinite;
	}

	.logo-marquee:hover .logo-marquee-track {
		animation-play-state: paused;
	}

	.project-logo-card {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: clamp(8.5rem, 14vw, 11.25rem);
		height: clamp(4rem, 6vw, 5rem);
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}

	.project-logo-card img {
		max-width: 100%;
		max-height: 2.75rem;
		object-fit: contain;
	}

	.project-logo-card span {
		color: var(--color-accent);
		font-family: var(--font-sans);
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1.35;
		text-align: center;
		text-transform: uppercase;
	}

	@keyframes logo-scroll {
		from {
			transform: translateX(calc(-50% - 0.375rem));
		}

		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-marquee-track {
			animation: none;
		}
