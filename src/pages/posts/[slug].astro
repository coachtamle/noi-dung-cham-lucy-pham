---
import {
	getEmDashEntry,
	getEmDashCollection,
	getEntryTerms,
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import PostCard from "../../components/PostCard.astro";
import { normalizeContentTitle } from "../../utils/content-text";
import { getReadingTime } from "../../utils/reading-time";
import { getPostFeaturedImage } from "../../utils/post-image";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function getImageUrl(img: unknown): string | undefined {
	if (typeof img === "string") return img.startsWith("http") ? img : `${Astro.url.origin}${img}`;
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src)
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	const meta = image.meta as Record<string, unknown> | undefined;
	const key = (typeof meta?.storageKey === "string" ? meta.storageKey : undefined)
		|| (typeof image.id === "string" ? image.id : undefined);
	return key ? `${Astro.url.origin}/_emdash/api/media/file/${key}` : undefined;
}

function normalizeInlineMarkdown(value: unknown): unknown {
	if (!Array.isArray(value)) return value;

	return value.map((block) => {
		if (!block || typeof block !== "object") return block;
		const portableBlock = block as Record<string, unknown>;
		if (!Array.isArray(portableBlock.children)) return block;

		let changed = false;
		const children = portableBlock.children.flatMap((child, childIndex) => {
			if (!child || typeof child !== "object") return [child];
			const span = child as Record<string, unknown>;
			if (span._type !== "span" || typeof span.text !== "string" || !span.text.includes("**")) return [child];
			const text = span.text;

			const parts: Record<string, unknown>[] = [];
			const pattern = /\*\*(.+?)\*\*/g;
			let cursor = 0;
			let partIndex = 0;
			let match: RegExpExecArray | null;

			while ((match = pattern.exec(text)) !== null) {
				if (match.index > cursor) {
					parts.push({
						...span,
						_key: `${String(span._key ?? `span-${childIndex}`)}-text-${partIndex++}`,
						text: text.slice(cursor, match.index),
					});
				}

				parts.push({
					...span,
					_key: `${String(span._key ?? `span-${childIndex}`)}-strong-${partIndex++}`,
					text: match[1],
					marks: [...(Array.isArray(span.marks) ? span.marks : []), "strong"],
				});
				cursor = pattern.lastIndex;
			}

			if (parts.length === 0) return [child];
			if (cursor < text.length) {
				parts.push({
					...span,
					_key: `${String(span._key ?? `span-${childIndex}`)}-text-${partIndex}`,
					text: text.slice(cursor),
				});
			}

			changed = true;
			return parts;
		});

		return changed ? { ...portableBlock, children } : block;
	});
}

function removeEmpowermentSubsectionNumbers(value: unknown): unknown {
	if (slug !== "tiep-thi-trao-quyen" || !Array.isArray(value)) return value;

	return value.map((block) => {
		if (!block || typeof block !== "object") return block;
		const portableBlock = block as Record<string, unknown>;
		if (!Array.isArray(portableBlock.children)) return block;

		let changed = false;
		const children = portableBlock.children.map((child) => {
			if (!child || typeof child !== "object") return child;
			const span = child as Record<string, unknown>;
			if (span._type !== "span" || typeof span.text !== "string") return child;

			const text = span.text.replace(/^4\.[1-3]\.\s*/, "");
			if (text === span.text) return child;
			changed = true;
			return { ...span, text };
		});

		return changed ? { ...portableBlock, children } : block;
	});
}

function mergeContentCareerParagraphs(value: unknown): unknown {
	if (slug !== "lam-nghe-content-tu-con-so-0" || !Array.isArray(value)) return value;

	const paragraphStarts = [
		"Không nhất thiết phải có bằng cấp chuyên ngành",
		"Tóm lại, dù bạn là ai",
		"Bạn vẫn có thể làm nghề content",
	];
	const blocks = [...value];

	for (let index = 0; index <= blocks.length - paragraphStarts.length; index++) {
		const candidates = blocks.slice(index, index + paragraphStarts.length);
		const texts = candidates.map((block) => {
			if (!block || typeof block !== "object") return "";
			const children = (block as Record<string, unknown>).children;
			if (!Array.isArray(children)) return "";
			return children
				.map((child) => (
					child && typeof child === "object" && typeof (child as Record<string, unknown>).text === "string"
						? (child as Record<string, unknown>).text
						: ""
				))
				.join("");
		});

		if (!paragraphStarts.every((start, offset) => texts[offset]?.startsWith(start))) continue;

		const firstBlock = candidates[0] as Record<string, unknown>;
		const firstChildren = Array.isArray(firstBlock.children) ? firstBlock.children : [];
		const firstSpan = firstChildren[0] && typeof firstChildren[0] === "object"
			? firstChildren[0] as Record<string, unknown>
			: { _type: "span" };
		const mergedText = texts.join(" ");
		const mergedBlock = {
			...firstBlock,
			children: [{ ...firstSpan, text: mergedText }],
		};

		blocks.splice(index, paragraphStarts.length, mergedBlock);
		break;
	}

	return blocks;
}

const featuredImage = getPostFeaturedImage(slug, post.data.featured_image, post.data.title);
const displayTitle = normalizeContentTitle(post.data.title);
const featuredImageUrl = getImageUrl(featuredImage);
const featuredImageLocal = typeof featuredImage === "string"
	? featuredImage
	: null;
const articleContent = mergeContentCareerParagraphs(
	removeEmpowermentSubsectionNumbers(normalizeInlineMarkdown(post.data.content)),
);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const rawSeo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
	defaultOgImage: featuredImageUrl,
});
const seo = {
	...rawSeo,
	title: normalizeContentTitle(rawSeo.title),
	ogTitle: normalizeContentTitle(rawSeo.ogTitle),
};

const bylines = post.data.bylines ?? [];
const readingTime = getReadingTime(post.data.content);

const [tags, { entries: recentPosts }] = await Promise.all([
	getEntryTerms("posts", post.data.id, "tag"),
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 4 }),
]);

const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: otherTagsByEntry.get(p.data.id) ?? [],
	bylines: p.data.bylines ?? [],
}));

const publishDate = post.data.publishedAt?.toLocaleDateString("vi-VN", {
	year: "numeric",
	month: "long",
	day: "numeric",
}) ?? null;

const pageUrl = Astro.url.href;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="article">

		<!-- ── Post layout: full-width with right sidebar ── -->
		<div class="post-layout">
		<div class="post-main">
			<!-- ── Header: meta → title → excerpt → author ── -->
			<header class="post-header">
				<div class="post-meta-line">
					{publishDate && <time>{publishDate}</time>}
					{readingTime > 0 && <><span class="meta-dot" aria-hidden="true">·</span><span>{readingTime} phút đọc</span></>}
					{tags.length > 0 && <><span class="meta-dot" aria-hidden="true">·</span><a href={`/tag/${tags[0].slug}`} class="meta-tag">{tags[0].label}</a></>}
				</div>

				<h1 class="article-title" {...post.edit.title}>{displayTitle}</h1>

				{post.data.excerpt && (
					<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
				)}

				<div class="post-byline">
					{bylines.length > 0 && (
						<div class="byline-author">
							{bylines[0].byline.avatarMediaId
								? <img src={`/_emdash/api/media/file/${bylines[0].byline.avatarMediaId}`} alt={bylines[0].byline.displayName} class="byline-avatar" />
								: <img src="/media/images/lucy/6852.jpg" alt={bylines[0].byline.displayName} class="byline-avatar" />
							}
							<span class="byline-name">{bylines[0].byline.displayName}</span>
						</div>
					)}
					<div class="byline-share">
						<a href="https://web.facebook.com/minhtrang.content.marketing/" target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Facebook">
							<svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.414c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.974h-1.513c-1.49 0-1.956.931-1.956 1.887v2.259h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
						</a>
						<button class="share-btn share-copy" data-url={pageUrl} aria-label="Sao chép link">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
							<span>Chia sẻ</span>
						</button>
					</div>
				</div>
			</header>

			{featuredImage && (
				<figure class="hero-figure" {...post.edit.featured_image}>
					{featuredImageLocal
						? <img src={featuredImageLocal} alt={displayTitle} class="hero-img" />
						: <div class="hero-img-wrap"><Image image={featuredImage as typeof post.data.featured_image} /></div>
					}
				</figure>
			)}

			<div class="content-wrap">
				<div class="article-content">
					<PortableText value={articleContent as typeof post.data.content} />
				</div>

				{tags.length > 0 && (
					<div class="post-tags">
						<span class="post-tags-label">Chủ đề</span>
						{tags.map((t) => (
							<a href={`/tag/${t.slug}`} class="post-tag-pill">{t.label}</a>
						))}
					</div>
				)}

				{bylines.length > 0 && (
					<div class="author-bio">
						<div class="rune-section-header" style="margin-bottom:1.5rem">
							<span class="rune-section-title">Tác giả</span>
						</div>
						{bylines.map((credit) => (
							<div class="author-bio-card">
								{credit.byline.avatarMediaId
									? <img
											src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
											alt={credit.byline.displayName}
											class="author-bio-avatar"
										/>
									: <img
											src="/media/images/lucy/6852.jpg"
											alt={credit.byline.displayName}
											class="author-bio-avatar"
										/>
								}
								<div class="author-bio-info">
									<span class="author-bio-name">{credit.byline.displayName}</span>
									<p class="author-bio-desc">
										Content Strategist, đồng hành cùng thương hiệu xây chiến lược nội dung dựa trên sự thấu cảm.
									</p>
									<a href="/ve-toi" class="author-bio-link">Tìm hiểu thêm →</a>
								</div>
							</div>
						))}
					</div>
				)}
			</div>
		</div> <!-- end .post-main -->

		<!-- Right sidebar -->
		<aside class="post-sidebar">
				<NewsletterSignup />

				<div class="ps-widget ps-widget--quote">
					<p>"Sự thấu cảm là điểm khởi đầu của mọi kết nối"</p>
				</div>

				{tags.length > 0 && (
					<div class="ps-widget">
						<p class="ps-label">Chủ đề bài này</p>
						<div class="ps-tags">
							{tags.map((t) => (
								<a href={`/tag/${t.slug}`} class="ps-tag">{t.label}</a>
							))}
						</div>
					</div>
				)}

				<div class="ps-widget">
					<p class="ps-label">Liên hệ</p>
					<div class="ps-contact">
						<a href="mailto:lucypham.content@gmail.com">lucypham.content@gmail.com</a>
						<a href="/ve-toi">Về Lucy Phạm</a>
					</div>
				</div>
			</aside>
		</div>
	</article>

	<!-- ── Related posts ── -->
	{otherPostsWithTags.length > 0 && (
		<section class="more-section">
			<div class="more-inner">
				<div class="rune-section-header">
					<span class="rune-section-title">Bài viết tiếp theo</span>
					<a href="/posts" class="rune-section-link">Xem tất cả →</a>
				</div>
				<div class="more-list">
					{otherPostsWithTags.map(({ post: p, tags: t }) => (
						<a href={`/posts/${p.id}`} class="more-row">
							<div class="more-thumb">
								{typeof getPostFeaturedImage(p.id, p.data.featured_image, p.data.title) === "string"
									? <img src={getPostFeaturedImage(p.id, p.data.featured_image, p.data.title) as string} alt={normalizeContentTitle(p.data.title)} loading="lazy" />
									: <div class="more-thumb-placeholder" />
								}
							</div>
							<div class="more-content">
								{t[0] && <span class="more-tag">{t[0].label}</span>}
								<h3 class="more-title">{normalizeContentTitle(p.data.title)}</h3>
								{p.data.excerpt && <p class="more-excerpt">{p.data.excerpt}</p>}
								<span class="more-meta">{p.data.publishedAt?.toLocaleDateString("vi-VN", { day: "numeric", month: "long", year: "numeric" })}</span>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	)}

	<script>
		document.querySelector<HTMLButtonElement>(".share-copy")?.addEventListener("click", function () {
			const url = this.dataset.url ?? location.href;
			navigator.clipboard.writeText(url).then(() => {
				const span = this.querySelector("span");
				if (span) {
					span.textContent = "Đã sao chép!";
					setTimeout(() => { span.textContent = "Chia sẻ"; }, 2000);
				}
			});
		});
	</script>
</Base>

<style>
/* ── Post layout: main + right sidebar ── */
.post-layout {
	display: grid;
	grid-template-columns: minmax(0, 1fr) 260px;
	gap: 3.5rem;
	max-width: calc(var(--wide-width) + 2.5rem);
	margin: 0 auto;
	padding: 1.5rem 1.5rem 0;
	align-items: start;
}

.post-main {
	min-width: 0;
}

/* ── Post header ── */
.post-header {
	margin-bottom: 2rem;
	padding-bottom: 1.5rem;
	border-bottom: 1px solid var(--color-border);
}

.post-meta-line {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	margin-bottom: 1.25rem;
	color: var(--color-muted);
	font-size: var(--font-size-sm);
	font-weight: 500;
}

.meta-dot { opacity: 0.5; }

.meta-tag {
	color: var(--color-accent);
	font-weight: 700;
	transition: opacity 140ms;
}
.meta-tag:hover { opacity: 0.75; }

.article-title {
	font-family: var(--font-serif);
	font-size: clamp(1.45rem, 2.35vw, 2.1rem);
	font-weight: 700;
	line-height: 1.28;
	letter-spacing: 0;
	color: var(--color-text);
	margin: 0 0 1rem;
}

.article-excerpt {
	font-size: var(--font-size-lg);
	line-height: 1.7;
	color: var(--color-text-secondary);
	margin-bottom: 1.5rem;
}

.post-byline {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	flex-wrap: wrap;
}

.byline-author {
	display: flex;
	align-items: center;
	gap: 0.625rem;
}

.byline-avatar {
	width: 30px;
	height: 30px;
	border-radius: 50%;
	object-fit: cover;
	flex-shrink: 0;
}

.byline-name {
	font-size: var(--font-size-sm);
	font-weight: 600;
	color: var(--color-text-secondary);
}

.byline-share {
	display: flex;
	align-items: center;
	gap: 0.375rem;
}

/* Share buttons */
.share-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.375rem;
	padding: 0.35rem 0.65rem;
	border: 1px solid var(--color-border);
	border-radius: var(--radius);
	background: transparent;
	color: var(--color-text-secondary);
	font-size: var(--font-size-xs);
	font-weight: 500;
	text-decoration: none;
	cursor: pointer;
	transition: background 150ms, color 150ms;
	font-family: inherit;
	line-height: 1;
}

.share-btn:hover {
	background: var(--color-surface);
	color: var(--color-text);
}

/* ── Hero image (full-width of post-main, after header) ── */
.hero-figure {
	margin: 0 0 2rem;
	overflow: hidden;
	aspect-ratio: 16 / 9;
}

.hero-img {
	width: 100%;
	height: 100%;
	display: block;
	object-fit: cover;
	object-position: center;
}

.hero-img-wrap {
	overflow: hidden;
	background: var(--color-surface);
	height: 100%;
}

.hero-img-wrap :global(img) {
	width: 100%;
	height: 100%;
	display: block;
	object-fit: cover;
	object-position: center;
}

/* ── Content ── */
.content-wrap {
	padding: 0 0 4rem;
}

/* ── Article content typography ── */
.article-content {
	font-family: var(--font-sans);
	font-size: 1.05rem;
	font-weight: 400;
	line-height: 1.72;
	letter-spacing: 0.006em;
	word-spacing: 0.025em;
	color: var(--color-text);
}

.article-content :global(p) {
	margin-bottom: 1em;
	font-weight: 400;
}

.article-content :global(strong) {
	font-weight: 700;
}

.article-content :global(h2) {
	font-family: var(--font-serif);
	font-size: 1.5rem;
	font-weight: 700;
	line-height: 1.35;
	letter-spacing: 0;
	word-spacing: normal;
	margin-top: 1.75em;
	margin-bottom: 0.6em;
	scroll-margin-top: 80px;
	color: var(--color-text);
}

.article-content :global(h3) {
	font-family: var(--font-serif);
	font-size: 1.25rem;
	font-weight: 600;
	line-height: 1.4;
	letter-spacing: 0;
	word-spacing: normal;
	margin-top: 1.5em;
	margin-bottom: 0.45em;
	scroll-margin-top: 80px;
	color: var(--color-text);
}

.article-content :global(blockquote) {
	margin: 2em 0;
	padding: 1.25rem 1.5rem;
	border-left: 3px solid var(--color-accent);
	background: var(--color-bg-subtle);
	border-radius: 0 8px 8px 0;
	color: var(--color-text-secondary);
	font-style: italic;
	font-size: 1.0625rem;
}

.article-content :global(pre) {
	margin: 2em 0;
	padding: 1.25rem;
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: 8px;
	overflow-x: auto;
	font-family: "JetBrains Mono", monospace;
	font-size: 0.875rem;
	line-height: 1.6;
}

.article-content :global(code) {
	font-family: "JetBrains Mono", monospace;
	font-size: 0.9em;
	background: var(--color-surface);
	padding: 0.2em 0.4em;
	border-radius: 4px;
}

.article-content :global(pre code) { background: none; padding: 0; }

.article-content :global(ul),
.article-content :global(ol) { margin-bottom: 1em; padding-left: 1.5em; }

.article-content :global(li) { margin-bottom: 0.35em; }

.article-content :global(img) {
	margin: 2em 0;
	border-radius: 8px;
	width: 100%;
	height: auto;
}

.article-content :global(hr) {
	margin: 3em 0;
	border: none;
	border-top: 1px solid var(--color-border);
}

.article-content :global(a) {
	color: var(--color-accent);
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}

.article-content :global(a:hover) { text-decoration-thickness: 2px; }

/* ── Author bio ── */
.author-bio {
	margin-top: 3.5rem;
	padding-top: 2rem;
	border-top: 1px solid var(--color-border-subtle);
}

.author-bio-card {
	display: flex;
	gap: 1.25rem;
	align-items: flex-start;
}

.author-bio-avatar {
	width: 56px;
	height: 56px;
	border-radius: 50%;
	object-fit: cover;
	flex-shrink: 0;
}

.author-bio-name {
	display: block;
	font-family: var(--font-sans);
	font-size: 1rem;
	font-weight: 700;
	color: var(--color-text);
	margin-bottom: 0.375rem;
}

.author-bio-desc {
	font-size: 0.9375rem;
	line-height: 1.7;
	color: var(--color-text-secondary);
	margin-bottom: 0.75rem;
}

.author-bio-link {
	font-size: 0.875rem;
	font-weight: 500;
	color: var(--color-accent);
	text-decoration: none;
	transition: opacity 150ms;
}
.author-bio-link:hover { opacity: 0.75; }

/* ── Post tags ── */
.post-tags {
