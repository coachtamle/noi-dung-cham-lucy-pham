---
import { getMenu, getEmDashCollection, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} - ${siteTitle}`;
const menu = await getMenu("primary");
const socialMenu = await getMenu("social");
const isLoggedIn = !!Astro.locals.user;

const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);
const labelMap: Record<string, string> = {
	posts: 'Góc chuyên môn',
	've-toi': 'Về Lucy Phạm',
	search: 'Tìm kiếm',
	tag: 'Chủ đề',
	category: 'Danh mục',
	pages: 'Trang',
};
const crumbs = segments.map((seg, i) => ({
	label: i === segments.length - 1 ? (pageTitle ?? labelMap[seg] ?? seg) : (labelMap[seg] ?? seg),
	href: '/' + segments.slice(0, i + 1).join('/'),
	isLast: i === segments.length - 1,
}));

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Noto+Serif:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="mobile-header"><a href="/" class="mobile-header-logo"><img src="/media/images/lucy/logo.svg" alt={siteTitle} class="mobile-header-logo-img" /></a><button class="sidebar-toggle" aria-label="Mở menu" aria-expanded="false"><span></span><span></span><span></span></button></header>
		<aside class="sidebar" id="sidebar"><div class="sidebar-inner"><div class="sidebar-top"><a href="/" class="sidebar-logo"><img src="/media/images/lucy/logo.svg" alt={siteTitle} class="sidebar-logo-img" /></a></div><nav class="sidebar-nav" aria-label="Navigation chính">{menu?.items.map((item) => (<a href={item.url} target={item.target}>{item.label}</a>))}</nav><div class="sidebar-bottom">{socialMenu && socialMenu.items.length > 0 && (<div class="sidebar-social">{socialMenu.items.map((item) => (<a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>{item.label}</a>))}</div>)}<a href="mailto:lucypham.content@gmail.com" class="sidebar-cta">Liên hệ hợp tác<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a><div class="sidebar-utils"><a href="/search">Tìm kiếm</a>{isLoggedIn && <a href="/_emdash/admin">Admin</a>}</div><p class="sidebar-copy">© Lucy Phạm</p></div></div></aside>
		<div class="sidebar-overlay" id="sidebar-overlay"></div>
		<div class="site-content"><nav class="breadcrumb-bar" aria-label="Breadcrumb">{crumbs.length === 0 ? <span class="bc-current">Trang chủ</span> : <a href="/">Trang chủ</a>}{crumbs.map((crumb) => (<><span class="bc-sep" aria-hidden="true">/</span>{crumb.isLast ? <span class="bc-current">{crumb.label}</span> : <a href={crumb.href}>{crumb.label}</a>}</>))}</nav><main><slot /></main></div>

		<style is:global>
			*, *::before, *::after { box-sizing: border-box; }
			body, h1, h2, h3, h4, h5, h6, p, ul, ol, figure, blockquote { margin: 0; }
			ul, ol { padding: 0; }
			#dich-vu .service-grid > .service-card:nth-child(2) .service-img img { object-fit: cover !important; object-position: center !important; }
		</style>
		<style>
			.sidebar{position:fixed;top:0;left:0;width:var(--sidebar-width);height:100vh;overflow-y:auto;border-right:1px solid var(--color-border);background:var(--color-bg);z-index:200;display:flex;flex-direction:column}.sidebar-inner{display:flex;flex-direction:column;height:100%;padding:2.5rem 1.75rem}.sidebar-top{margin-bottom:2.5rem}.sidebar-logo{display:block;margin-bottom:.6rem;color:var(--color-text);line-height:1.2}.sidebar-logo-img{display:block;width:min(100%,168px);height:auto;transform:translateX(-12px)}.sidebar-nav{display:flex;flex-direction:column;gap:.15rem}.sidebar-nav a{display:block;padding:.5rem 0;color:var(--color-text-secondary);font-family:var(--font-sans);font-size:.95rem;font-weight:600;line-height:1.45;border-bottom:1px solid transparent;transition:color 140ms ease}.sidebar-nav a:hover{color:var(--color-accent)}.sidebar-nav a[href="/#contact"]{font-family:var(--font-sans);font-size:.95rem;font-weight:600;letter-spacing:0}.sidebar-bottom{margin-top:auto;padding-top:2rem;display:grid;gap:1rem}.sidebar-social{display:flex;flex-direction:column;gap:.35rem}.sidebar-social a,.sidebar-utils a{color:var(--color-muted);font-size:var(--font-size-xs);font-weight:600;transition:color 140ms ease}.sidebar-social a:hover,.sidebar-utils a:hover{color:var(--color-accent)}.sidebar-cta{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.75rem 1rem;background:var(--color-accent);color:#fff!important;font-size:var(--font-size-sm);font-weight:700;border-radius:var(--radius);transition:opacity 140ms ease;text-decoration:none}.sidebar-cta:hover{opacity:.88}.sidebar-utils{display:flex;gap:1rem}.sidebar-copy{color:var(--color-muted);font-size:var(--font-size-xs)}.site-content{margin-left:var(--sidebar-width);flex:1;min-width:0}main{min-height:100vh}.breadcrumb-bar{display:flex;align-items:center;gap:.5rem;padding:.85rem 1.5rem;border-bottom:1px solid var(--color-border-subtle);font-size:var(--font-size-xs);font-weight:500;color:var(--color-muted)}.breadcrumb-bar a{color:var(--color-text-secondary);transition:color 140ms ease}.breadcrumb-bar a:hover{color:var(--color-accent)}.bc-sep{opacity:.4;font-size:.7em}.bc-current{color:var(--color-text);font-weight:600;max-width:40ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mobile-header{display:none;position:fixed;top:0;left:0;right:0;height:64px;padding:0 1rem;align-items:center;justify-content:space-between;background:color-mix(in srgb,var(--color-bg) 92%,transparent);border-bottom:1px solid var(--color-border);backdrop-filter:blur(16px);z-index:250}.mobile-header-logo-img{max-height:42px;width:auto}.sidebar-toggle{display:grid;gap:4px;padding:.5rem;background:transparent;border:0}.sidebar-toggle span{display:block;width:22px;height:2px;background:var(--color-text)}.sidebar-overlay{display:none}.sidebar-overlay.active{display:block;position:fixed;inset:0;background:rgba(0,0,0,.24);z-index:180}@media(max-width:900px){.mobile-header{display:flex}.sidebar{transform:translateX(-100%);transition:transform 180ms ease}.sidebar.active{transform:translateX(0)}.site-content{margin-left:0;padding-top:64px}.breadcrumb-bar{display:none}}
		</style>
		<script>const toggle=document.querySelector('.sidebar-toggle');const sidebar=document.querySelector('#sidebar');const overlay=document.querySelector('#sidebar-overlay');toggle?.addEventListener('click',()=>{const active=sidebar?.classList.toggle('active');overlay?.classList.toggle('active',!!active);toggle?.setAttribute('aria-expanded',String(!!active));});overlay?.addEventListener('click',()=>{sidebar?.classList.remove('active');overlay?.classList.remove('active');toggle?.setAttribute('aria-expanded','false');});</script>
		<script src="/project-logo-start.js?v=20260628-2" defer></script>
		<script src="/project-logos.js?v=20260628-2" defer></script>
		<script src="/project-logo-controls.js?v=20260628-2" defer></script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
